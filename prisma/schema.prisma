generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid()) @map("_id")
  email        String  @unique
  firstName    String
  lastName     String
  password     String
  role         Role    @default(PORTFOLIO_MANAGER)
  avatar       String?
  active       Boolean @default(true)
  /// Firm the user belongs to, shown on the Settings > Profile tab. Free text —
  /// there is no Organization model; this is a label, not a tenancy boundary.
  organization String?

  /// Settings > Preferences. Every field is optional at the DB level so existing
  /// rows read back as null; UsersService substitutes the documented defaults
  /// (system / USD / MMM D, YYYY / en-US / comfortable) so the API always
  /// returns a fully-populated object and the UI never renders an empty select.
  theme        String?
  baseCurrency String?
  dateFormat   String?
  numberFormat String?
  density      String?

  /// Settings > Notifications. Nullable for the same reason as above: absent
  /// means "never chosen", which resolves to the default in UsersService rather
  /// than to `false` — otherwise every existing user would silently be opted out.
  notifyTradeAlerts       Boolean?
  notifyPriceTargets      Boolean?
  notifyWeeklyDigest      Boolean?
  notifyCorporateActions  Boolean?
  notifyProductUpdates    Boolean?

  /// Settings > Security, Two-Factor Authentication (TOTP).
  ///
  /// `twoFactorSecret` holds the base32 shared secret. It is written during
  /// setup — before the user has proven they can generate a code — so
  /// `twoFactorEnabled` is the only flag the login gate reads. A secret with the
  /// flag still false means "setup started but never confirmed", and is simply
  /// overwritten by the next setup attempt.
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  /// bcrypt hashes of the single-use recovery codes shown once at enrolment.
  /// Hashed for the same reason passwords are: a database leak must not hand
  /// over a working second factor. A consumed code is spliced out of the array.
  twoFactorRecoveryCodes String[] @default([])
  twoFactorEnabledAt     DateTime?

  sessions Session[]

  /// When set, this User is a client login (role VIEWER) created from the client
  /// add/edit form, scoped to a single mandate. Staff logins leave this null.
  ///
  /// NOT `@unique`: on MongoDB a unique index over an optional FK treats every
  /// staff row (clientId absent → indexed as null) as a duplicate, so the index
  /// can't build. One-login-per-client is enforced in ClientsService instead.
  /// Cascades: deleting the client removes its login.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// One-time password issued for the forgot-password flow. A row is created when
/// a user requests a reset; the 6-digit code is stored hashed (never in the
/// clear), expires after a few minutes, and is deleted once consumed. Old rows
/// for the same email are cleared on each new request so only the latest is valid.
model PasswordReset {
  id        String   @id @default(cuid()) @map("_id")
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_resets")
}

/// One row per signed-in device, created when a login completes and deleted when
/// that device is revoked or signs out. This is what Settings > Security lists.
///
/// The refresh token is stored as a SHA-256 hash, not in the clear: the row's
/// whole purpose is to let a user kill a session they don't recognise, and a
/// readable token would let anyone with database access resume it instead.
/// AuthService checks every refresh against this table, so deleting the row is
/// what actually ends the session — the access token then expires on its own.
model Session {
  id     String @id @default(cuid()) @map("_id")
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the refresh token. Rotated on every successful refresh so a
  /// stolen-and-replayed token can't outlive the legitimate device's next call.
  refreshTokenHash String @unique

  /// Raw User-Agent plus what we parsed out of it, denormalized so the list
  /// endpoint doesn't re-parse on every read. Nullable: a non-browser client
  /// (curl, a test) may send no User-Agent at all.
  userAgent String?
  browser   String?
  os        String?
  ip        String?

  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

enum Role {
  ADMIN
  PORTFOLIO_MANAGER
  RESEARCH_ANALYST
  VIEWER
}

model Client {
  id            String      @id @default(cuid()) @map("_id")
  name          String
  broker        String
  accountNumber String
  /// Optional contact email for the mandate. Nullable: legacy clients predate
  /// this field. Stored lowercased/trimmed by the DTO.
  email         String?
  /// Free-text label kept for the existing CRUD UI. Analytics joins on benchmarkId
  /// instead: a string like "swderfg" cannot be joined to a price series.
  benchmark     String
  benchmarkId   String?
  riskProfile   RiskProfile

  /// Which cash flows feed this client's XIRR. See PerformanceService.
  ///
  /// CASH_FLOW    — the manager records the money the client actually handed over
  ///                and took back (CASH_DEPOSIT / CASH_WITHDRAWAL). Trades are
  ///                internal reshuffling and are NOT flows.
  /// TRANSACTIONAL — no external flow record exists; each BUY is treated as money
  ///                in and each SELL as money out, so the return is measured on
  ///                capital deployed into positions.
  ///
  /// The cash-flow method has been retired from the product: every client is now
  /// transactional. The enum value is kept so legacy records still read, but
  /// nothing writes CASH_FLOW anymore and the default for new rows is
  /// TRANSACTIONAL. See ClientsService, which forces this on every write.
  accountingMethod AccountingMethod @default(TRANSACTIONAL)

  /// Only meaningful under TRANSACTIONAL. Excluding fees gives the gross-of-fee
  /// return the manager is measured on; including them gives the net-of-fee
  /// return the client actually received. Both default ON, so the headline
  /// number is the one the client experienced.
  ///
  /// Under CASH_FLOW these are ignored — dividends and fees are already inside
  /// the terminal value there, because the cash landed in (or left) the balance.
  /// Counting them as flows as well would double-count them.
  includeDividends Boolean @default(true)
  includeFees      Boolean @default(true)

  currency       String       @default("USD")

  /// Which book of business this mandate belongs to — see common/market-scope.ts.
  ///
  /// The firm runs a US book and an Indian one out of this single database, and
  /// this is the dimension nearly every read filters on: the dashboard, holdings,
  /// performance and reports are all scoped to one market at a time via the
  /// header's country selector.
  ///
  /// Defaults to US so every client that predates the Indian book keeps reading
  /// exactly as before rather than vanishing from an unscoped query. It is NOT
  /// derived from `currency`: currency is a reporting unit that a US mandate
  /// could in principle change, whereas market determines which exchange the
  /// tickers resolve against and which indices benchmark the book.
  market         Market       @default(US)

  /// The household this mandate belongs to, if any — see Family.
  ///
  /// Nullable because most mandates stand alone; only the accounts a manager
  /// has explicitly grouped carry it. Set to null (not cascaded) when the
  /// family is deleted, so dissolving a household never deletes a client.
  familyId       String?
  family         Family?      @relation(fields: [familyId], references: [id], onDelete: SetNull)

  status         ClientStatus @default(ACTIVE)
  cashBalance    Float        @default(0)
  portfolioValue Float        @default(0)
  xirr           Float        @default(0)
  notes          String?

  /// Annual management fee, as a percent (e.g. 2 for 2%). Billed quarterly at
  /// feeRatePercent / 4 of quarter-end portfolio value. Defaulted for clients
  /// created before this field existed; required on create going forward.
  feeRatePercent Float    @default(0)
  /// The mandate's actual start date, used to prorate the first (partial)
  /// billing quarter. NOT the same as createdAt, which is only when the
  /// record was entered into Atlas PMS and may postdate real inception for
  /// backfilled clients. Defaults to createdAt's value at write time for
  /// clients created before this field existed.
  inceptionDate  DateTime @default(now())

  holdings     Holding[]
  transactions Transaction[]
  research     Research[]

  /// The client's own login account(s) (role VIEWER), if one was set from the
  /// add/edit form. Modeled as a list because the FK isn't a unique index on
  /// MongoDB (see User.clientId), but ClientsService keeps it to at most one.
  loginUsers User[]

  /// The immutable legacy import baseline (see PortfolioBaseline). Not
  /// `@unique` here — the one-per-client rule is a Prisma-relation-field
  /// convenience only; PortfolioBaseline.clientId carries the real @unique
  /// constraint that enforces it at the database level.
  baseline   PortfolioBaseline?
  /// Historical daily NAV rows written by the snapshot scheduler — see
  /// PortfolioHistoryService. Empty until the first snapshot runs for this
  /// client.
  valuations PortfolioValuation[]
  /// Frozen per-quarter fee records, one per CLOSED quarter. Note that these
  /// carry their own copy of feeRatePercent: editing the rate above changes
  /// future billing only, never a quarter already closed.
  feeSchedules ClientFeeSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([name])
  /// Every market-scoped read starts `market = ?`, usually alongside a status
  /// filter — a compound index keeps that from scanning the whole collection
  /// once the second book grows.
  @@index([market, status])
  /// The family aggregate reads every member in one query.
  @@index([familyId])
  @@map("clients")
}

enum RiskProfile {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

enum AccountingMethod {
  TRANSACTIONAL
  CASH_FLOW
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

/// The book of business a client or instrument belongs to. Adding a market here
/// plus an entry in common/market-scope.ts is the whole change needed to run a
/// third book — no service reads a hardcoded exchange or currency.
enum Market {
  US
  INDIA
}

model Holding {
  id       String @id @default(cuid()) @map("_id")
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ticker   String
  company  String
  sector   String
  industry String
  country  String
  theme    String?
  exchange String

  quantity          Float
  averageCost       Float
  currentPrice      Float
  marketValue       Float
  allocationPercent Float @default(0)
  unrealizedPnL     Float @default(0)
  realizedPnL       Float @default(0)
  dividend          Float @default(0)
  weight            Float @default(0)
  targetWeight      Float @default(0)
  holdingDays       Int   @default(0)

  investmentThesis String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, ticker])
  @@index([clientId])
  @@index([ticker])
  @@index([sector])
  @@map("holdings")
}

model Transaction {
  id       String @id @default(cuid()) @map("_id")
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ticker      String?
  type        TransactionType
  quantity    Float?
  price       Float?
  amount      Float
  date        DateTime
  description String?
  reference   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([ticker])
  @@index([date])
  /// The valuation replay issues `clientId = ? AND date <= ?` once per client.
  /// Separate single-field indexes make Mongo pick one and scan the rest.
  @@index([clientId, date])
  @@map("transactions")
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  SPLIT
  BONUS
  TRANSFER
  CASH_DEPOSIT
  CASH_WITHDRAWAL
  FEES
}

model Research {
  id       String  @id @default(cuid()) @map("_id")
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ticker           String
  investmentThesis String?
  whyBought        String?
  catalysts        String?
  risks            String?
  valuation        String?
  targetAllocation Float?
  targetPrice      Float?
  reviewDate       DateTime?
  reviewNotes      String?
  attachments      String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticker])
  @@index([clientId])
  @@map("research")
}

/// A tracked ticker with no priority/status workflow — returns (MTD/QTD/YTD)
/// are computed live from market data, not stored here. `slot` is one of five
/// fixed lists ("1".."5") a ticker can be placed on; the same ticker may
/// appear on more than one list.
model Watchlist {
  id       String @id @default(cuid()) @map("_id")
  slot     String @default("1")
  ticker   String
  company  String
  sector   String
  industry String

  /// Which book this tracked name belongs to.
  ///
  /// Scoped like every other read: switching the header's country selector to
  /// India shows the Indian watchlist, not a mixed table. That matters here more
  /// than elsewhere because the price column is rendered in the selected book's
  /// currency — a US name sitting in the Indian list would read as rupees.
  ///
  /// Defaults to US so every ticker added before the Indian book keeps showing
  /// on the US watchlist rather than vanishing from both.
  market   Market @default(US)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Scoped per book: the same ticker may sit on slot 1 of both books, and
  /// (more to the point) 'RELIANCE.NS' and a US name never collide.
  @@unique([market, slot, ticker])
  @@index([market, slot])
  @@map("watchlists")
}

/// Display name for each of the five watchlist slots. Rows are created
/// lazily (upsert) the first time a slot's name is changed from its default.
///
/// Named per book, so the Indian book's "Slot 1" can be "Nifty Compounders"
/// while the US book's stays "Core Longs".
model WatchlistFolder {
  id     String @id @default(cuid()) @map("_id")
  slot   String
  name   String
  market Market @default(US)

  @@unique([market, slot])
  @@map("watchlist_folders")
}

/// A household — several client mandates managed as one book.
///
/// The Indian desk in particular runs four or five accounts that belong to one
/// family (a couple, their children, an HUF), and the manager reasons about the
/// household's combined exposure: how much of RELIANCE the family holds in
/// total, at what blended cost, and how the sector mix looks once the accounts
/// are merged. Individual mandates stay first-class — this groups them for
/// reporting, it does not merge them.
///
/// Membership is a nullable FK on Client rather than a join table: a client
/// belongs to at most one family, and that is the rule the desk actually works
/// to. Deleting a family leaves its clients intact and unaffiliated
/// (onDelete: SetNull), because a household dissolving must never take the
/// underlying mandates' holdings with it.
model Family {
  id   String @id @default(cuid()) @map("_id")
  name String

  /// A family lives in ONE book. Aggregating an INR mandate with a USD one
  /// would sum two different units into a meaningless total, and the codebase
  /// carries no FX rate to convert between them — so the API rejects a member
  /// from another book rather than silently producing a wrong number.
  market Market @default(US)

  notes String?

  clients Client[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Families are listed per book, and a household name is unique within one.
  @@unique([market, name])
  @@index([market])
  @@map("families")
}

// ─────────────────────────────────────────────────────────────────────────────
// Analytics engine — see ANALYTICS_ARCHITECTURE.md
// ─────────────────────────────────────────────────────────────────────────────

/// Daily bars for every instrument AND every benchmark. Benchmarks are ordinary
/// symbols (^GSPC, ^IXIC) rather than a separate table, so "beta vs the S&P" and
/// "beta vs a peer stock" are the same code path.
///
/// Without this collection there is no return series, and Beta/Sharpe/Sortino/
/// drawdown/attribution cannot be computed at all.
model PriceBar {
  id       String   @id @default(cuid()) @map("_id")
  symbol   String
  date     DateTime
  open     Float?
  high     Float?
  low      Float?
  close    Float
  /// Split- and dividend-adjusted. Returns are ALWAYS computed from this, never
  /// from `close` — using close makes every stock that paid a dividend look like
  /// it crashed on the ex-date.
  adjClose Float
  volume   Float?
  /// "yahoo" | "workbook" | "manual" — provenance stays auditable.
  source   String

  createdAt DateTime @default(now())

  /// Doubles as the range-scan index every risk calc issues, and as the idempotent
  /// upsert key that makes backfill safely re-runnable.
  @@unique([symbol, date])
  @@map("price_bars")
}

/// Named benchmarks. Client.benchmark is free text today (the live value is
/// literally "swderfg"), and free text cannot drive a calculation.
model Benchmark {
  id        String  @id @default(cuid()) @map("_id")
  code      String  @unique
  name      String
  /// Join key into PriceBar.symbol.
  symbol    String
  /// Which book this benchmark belongs to, so the client form offers Nifty/Sensex
  /// for an Indian mandate and the S&P/Nasdaq for a US one. `isDefault` is scoped
  /// by market too — each book has its own default (S&P 500 / Nifty 50).
  market    Market  @default(US)
  isDefault Boolean @default(false)

  @@index([market])
  @@map("benchmarks")
}

/// One row per instrument. Today sector/industry/country are copied onto every
/// holding row of every client, so reclassifying one ticker is an N-client write
/// and any partial failure leaves the house-level rollup inconsistent with itself.
model InstrumentProfile {
  id         String     @id @default(cuid()) @map("_id")
  symbol     String     @unique
  company    String
  assetClass AssetClass @default(EQUITY)
  sector     String     @default("Unclassified")
  industry   String     @default("Unclassified")
  /// Domicile of the ISSUER. For a US-listed China ETF this is "United States",
  /// which is exactly why lookThrough exists.
  country    String     @default("Unknown")
  region     String     @default("Unknown")
  exchange   String     @default("Unknown")
  currency   String     @default("USD")

  /// Which book this instrument trades in, derived from the Yahoo suffix
  /// ('.NS'/'.BO' → INDIA, otherwise US) by marketForSymbol(). Stored rather
  /// than re-derived on every read so exposure rollups can group by it without
  /// parsing strings, and so a future market whose symbols are NOT
  /// suffix-distinguishable can be corrected by hand.
  market     Market     @default(US)

  /// ETF decomposition: { region: [{ key: "China", weight: 1 }], sector: [...] }.
  /// Null for single stocks. Without this, a book holding MCHI reports 0% China
  /// exposure, because Yahoo classifies the fund itself as US-domiciled.
  lookThrough Json?

  source     String    @default("manual")
  /// Set when a human sets the classification. The nightly Yahoo sync must not
  /// overwrite a considered manual decision.
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sector])
  @@index([region])
  @@index([market])
  @@map("instrument_profiles")
}

enum AssetClass {
  EQUITY
  ETF
  FUND
  CASH_EQUIV
}

/// Daily NAV per client. PriceBar gives instrument history; this gives PORTFOLIO
/// history, which is what risk/drawdown/XIRR actually consume.
model PortfolioValuation {
  id       String   @id @default(cuid()) @map("_id")
  clientId String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date     DateTime

  securitiesValue Float
  cashValue       Float
  totalValue      Float

  /// EXTERNAL flows only (deposits/withdrawals). A BUY moves cash into securities
  /// inside the portfolio and leaves NAV unchanged — counting it here would
  /// double-count and corrupt the return.
  netFlow Float @default(0)

  /// Flow-adjusted: (V_t - V_{t-1} - F_t) / V_{t-1}. Stored rather than derived on
  /// read because every risk metric scans this column, and recomputing it needs
  /// that day's flows from another collection.
  dailyReturn Float @default(0)

  positionCount Int     @default(0)
  /// Marks days where a price had to be carried forward. Stale days are excluded
  /// from volatility — a stale price makes risk read artificially LOW.
  stale         Boolean @default(false)
  source        String  @default("eod-job")

  /// Sum of quantity * averageCost across positions as of `date` — the
  /// accounting-cost figure, distinct from `totalValue` (market value). Used by
  /// gain/loss reporting; never fed into performance-return math.
  totalCost Float @default(0)
  /// totalValue's securities leg minus totalCost. Derived at write time and
  /// cached here so historical reports don't need a live replay to show it.
  unrealizedPnL Float @default(0)
  /// Cumulative realized gain from every SELL replayed up to and including
  /// `date`. Cumulative (not "since last snapshot") so any single row is a
  /// complete answer on its own.
  realizedPnL Float @default(0)
  /// Benchmark value on the same unit-purchase basis as PerformanceService,
  /// valued as of `date`. Null until a benchmark is resolved for the client.
  benchmarkValue Float?
  /// Portfolio XIRR as of `date`, using PortfolioHistoryService's own flow
  /// build (not PerformanceService's) — see PortfolioHistoryService for why
  /// the two are computed independently rather than sharing one call site.
  xirr Float?
  /// True only for the row the quarter-end scheduler wrote (or backfilled) for
  /// a given quarter. A quarter can also acquire an ordinary daily row on the
  /// same date before the scheduler runs; the scheduler upserts and sets this
  /// flag rather than assuming its row is the first to exist for that date.
  isQuarterEnd Boolean @default(false)

  holdings HoldingSnapshot[]

  createdAt DateTime @default(now())

  @@unique([clientId, date])
  @@map("portfolio_valuations")
}

/// One row = one position's state on a specific PortfolioValuation date. Together
/// with its parent this is the full "portfolio as it existed on that day" record
/// that PortfolioHistoryService reads before falling back to a live reconstruction
/// (see PART 7 in the architecture note / PortfolioHistoryService.getPortfolioAsOf).
///
/// Written once, atomically, alongside its parent PortfolioValuation row and never
/// edited afterward — a re-run of the snapshot job deletes and reinserts the full
/// set for that date rather than patching individual rows, so there is never a
/// partial write visible to a reader.
model HoldingSnapshot {
  id         String             @id @default(cuid()) @map("_id")
  snapshotId String
  snapshot   PortfolioValuation @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  ticker       String
  quantity     Float
  averageCost  Float
  closingPrice Float
  marketValue  Float
  /// Weight against the parent snapshot's totalValue (TOTAL_ASSETS basis, matching
  /// weights.ts elsewhere in the codebase).
  allocation Float
  sector     String
  industry   String
  /// Not in the original Part 6 field list, but needed so a snapshot-served
  /// read (PortfolioHistoryService.getPortfolioAsOf) can rebuild country and
  /// asset allocation from stored data alone — without them, a snapshot-served
  /// date silently returns empty breakdowns while a reconstructed one doesn't,
  /// breaking "the user should not know whether Snapshot or Reconstruction was
  /// used" (PART 7).
  country    String @default("Unknown")
  assetClass String @default("EQUITY")

  createdAt DateTime @default(now())

  @@index([snapshotId])
  @@map("holding_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fundamentals Engine — see FUNDAMENTALS_ARCHITECTURE.md
//
// Three collections, one direction of dependency: FundamentalSnapshot (raw,
// provider-sourced) -> ScoringRule (operator-authored, provider-agnostic) ->
// FundamentalScore (derived, cached). Nothing here is read by any of the
// modules listed as already-existing (Holdings, Dashboard, Transactions,
// Performance, Reports, Live Prices, Portfolio Analytics) and nothing here
// reads from them either — the engine is additive.
// ─────────────────────────────────────────────────────────────────────────────

/// One symbol's raw fundamental data, as last fetched from the active provider.
/// This is the ONLY collection a provider adapter is allowed to write to —
/// everything downstream (scoring, industry comparison, explanations) reads
/// this shape and never touches the provider's response directly, which is
/// what makes swapping FMP for Finnhub/AlphaVantage/Polygon a provider-layer
/// change only.
model FundamentalSnapshot {
  id     String @id @default(cuid()) @map("_id")
  symbol String @unique

  // ── Company information ────────────────────────────────────────────────
  company   String
  sector    String @default("Unclassified")
  industry  String @default("Unclassified")
  marketCap Float?

  // ── Valuation ───────────────────────────────────────────────────────────
  peRatio         Float?
  forwardPe       Float?
  pegRatio        Float?
  evToEbitda      Float?
  priceToSales    Float?
  priceToBook     Float?
  enterpriseValue Float?

  // ── Growth ──────────────────────────────────────────────────────────────
  revenueQoqPercent   Float?
  revenueYoyPercent   Float?
  netProfitQoqPercent Float?
  netProfitYoyPercent Float?
  revenueCagr3y       Float?
  netProfitCagr3y     Float?

  // ── Profitability ───────────────────────────────────────────────────────
  roe             Float?
  roic            Float?
  grossMargin     Float?
  operatingMargin Float?
  netMargin       Float?

  // ── Financial strength ──────────────────────────────────────────────────
  debtToEquity     Float?
  currentRatio     Float?
  interestCoverage Float?
  freeCashFlow     Float?

  // ── Momentum ────────────────────────────────────────────────────────────
  /// Average of the last up-to-4 quarters' (actual - estimated) / |estimated|,
  /// as a percent. Null when the provider has no estimate to compare against.
  lastFourEarningsBeatPercent Float?
  nextEarningsDate            DateTime?
  /// Derived at read time from nextEarningsDate in the service layer, NOT
  /// stored — "days until" only means something relative to today, and
  /// storing it would go stale the moment a day passes without a refresh.

  // ── Dividend ────────────────────────────────────────────────────────────
  dividendYield    Float?
  dividendPerShare Float?
  exDividendDate   DateTime?
  paymentDate      DateTime?

  /// "fmp" today; any adapter implementing FundamentalsProvider sets its own key.
  source      String   @default("fmp")
  refreshedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sector])
  @@index([industry])
  @@map("fundamental_snapshots")
}

/// One row = one banded rule for one metric under one strategy. The scoring
/// engine is ONLY this table plus a range lookup — there is deliberately no
/// switch/if-chain in code mapping a metric name to a score. Adding a new
/// factor, re-tuning a band, or authoring an entirely new strategy (Growth,
/// Value, Quality, Dividend, Small Cap, AI, ...) is a data change: insert
/// rows here, restart nothing, ship nothing.
///
/// A metric's rows within one strategy must tile the number line with no gaps
/// and no overlaps for the engine to always find exactly one match; the seed
/// data follows that convention but it is not (and cannot be) enforced by the
/// database schema itself, so treat it as a contract for anyone authoring rules.
model ScoringRule {
  id String @id @default(cuid()) @map("_id")

  /// e.g. "Revenue YoY", "ROIC", "PE vs Industry" — must match the key the
  /// ScoringEngine looks up for that pillar's metric. See scoring-metrics.ts.
  metricName   String
  minimumValue Float
  maximumValue Float
  /// Points awarded [0..100] when the metric falls in [minimumValue, maximumValue).
  score        Float
  /// This metric's weight (points out of the pillar's total) under this strategy.
  /// Duplicated on every band row for the same metric+strategy by design —
  /// weight is a property of the METRIC, banding is a property of the VALUE,
  /// and keeping them on one row is what lets the engine compute
  /// `score/100 * weight` from a single matched record with no join.
  weight       Float
  /// "GARP" | "Growth" | "Value" | "Quality" | "Dividend" | "Small Cap" | "AI" | ...
  /// Free text on purpose: a brand-new strategy is rows with a new string here,
  /// never a schema migration or an enum change.
  strategy     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([strategy, metricName])
  @@map("scoring_rules")
}

/// One symbol's computed Atlas Fundamental Score under one strategy, cached so
/// the watchlist doesn't re-run five pillars' worth of rule lookups on every
/// render. Recomputed by the same daily refresh that pulls fresh snapshots,
/// and on demand if a caller asks for a symbol/strategy pair with no cache row.
model FundamentalScore {
  id       String @id @default(cuid()) @map("_id")
  symbol   String
  /// Matches ScoringRule.strategy — one symbol can be scored under several
  /// strategies at once (e.g. both "GARP" and "Growth") without collision.
  strategy String

  overallScore           Float
  growthScore            Float
  profitabilityScore     Float
  financialStrengthScore Float
  valuationScore         Float
  momentumScore          Float

  /// Per-metric breakdown: [{ metric, value, matchedRange, score, weight,
  /// contribution, pillar }, ...]. This is what powers the "hover for full
  /// breakdown" requirement — the UI renders this directly rather than
  /// re-deriving it, so the tooltip can never disagree with the number
  /// next to it.
  breakdown Json

  /// { strengths: string[], weaknesses: string[] } — see ExplanationEngine.
  explanation Json

  industryComparison Json?

  computedAt DateTime @default(now())

  @@unique([symbol, strategy])
  @@index([strategy, overallScore])
  @@map("fundamental_scores")
}

/// One row = one upcoming corporate event (earnings / dividend / split) as last
/// fetched from FMP's date-ranged calendars. The Event Center reads THIS, never
/// FMP directly, so the page keeps working when the FMP request budget is
/// exhausted or the process just restarted — same durability the Fundamentals
/// Engine gets from FundamentalSnapshot. A manual refresh (POST /events/refresh)
/// re-fetches the calendars and upserts these rows; nothing else writes here.
///
/// company / clientCount are deliberately NOT stored — they belong to Holding
/// and would drift the moment a position changes. The service joins them on at
/// read time. `ticker + type + date` is the natural key: FMP can list at most
/// one event of a given type per ticker per day.
model EventSnapshot {
  id     String @id @default(cuid()) @map("_id")
  ticker String
  /// "EARNINGS" | "DIVIDEND" | "SPLIT" — matches WatchlistEventType.
  type   String
  /// "E" | "D" | "C" badge code, carried through from the source event.
  code   String
  label  String
  /// ISO date (YYYY-MM-DD) the event falls on.
  date   String
  /// "Upcoming" | "Confirmed".
  status String

  source      String   @default("fmp")
  refreshedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ticker, type, date])
  @@index([ticker])
  @@map("event_snapshots")
}

/// Precomputed rollups. MongoDB has no GROUP BY across relations, so house-level
/// analytics are computed once by the nightly job rather than aggregated on every
/// read. This is the concession that makes 1000+ clients viable on Mongo; it costs
/// eventual consistency on house figures.
model AnalyticsCache {
  id        String   @id @default(cuid()) @map("_id")
  /// "house" | "client:<id>" | "overlap"
  scope     String
  metric    String
  asOf      DateTime
  payload   Json
  /// Fingerprint of the inputs, including a calcVersion that is bumped whenever a
  /// calculator's logic changes — otherwise a fixed formula keeps serving stale
  /// wrong numbers from cache, invisibly.
  inputHash String

  computedAt DateTime @default(now())

  @@unique([scope, metric, asOf])
  @@index([scope, asOf])
  @@map("analytics_cache")
}

// ─────────────────────────────────────────────────────────────────────────────
// Legacy Portfolio Baseline & Historical Reconstruction
//
// Real transaction history before the baseline date does not exist — clients
// were bulk-imported as a snapshot of positions on a single date. Everything
// from that date forward IS tracked transactionally in the existing
// Transaction table. PortfolioReconstructionService replays Transaction rows
// on top of BaselineHolding[] to answer "what did this portfolio look like on
// date X", for any X after the baseline; PortfolioHistoryService caches that
// answer as a PortfolioValuation + HoldingSnapshot[] row so most historical
// reads don't require a full replay.
// ─────────────────────────────────────────────────────────────────────────────

/// The immutable opening position for one client — what was imported before
/// Atlas started recording transactions. Exactly one per client, and normally
/// never touched again after creation: `@unique` on `clientId` is the database
/// half of that guarantee, and BaselineService exposes no update method at all.
/// The only path that can change a locked baseline is BaselineAdminService,
/// gated to ADMIN and required to append to `remarks` rather than overwrite —
/// see that service for the audit-trail rationale.
model PortfolioBaseline {
  id       String @id @default(cuid()) @map("_id")
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// e.g. 2026-06-30. PortfolioReconstructionService refuses to reconstruct any
  /// date before this one — there is nothing to replay onto.
  baselineDate          DateTime
  openingPortfolioValue Float
  openingCash           Float
  remarks               String?

  createdAt DateTime  @default(now())
  /// User id of whoever created (or, via BaselineAdminService, amended) this
  /// row. Not a relation: the creating user may later be deactivated, and the
  /// baseline must still show who set it.
  createdBy String?
  /// Set once the baseline is confirmed correct. Null briefly covers the
  /// window between import and manual confirmation; BaselineService.create()
  /// currently sets it immediately, but the field exists so a future
  /// "review before locking" step doesn't need a migration.
  lockedAt  DateTime?

  holdings BaselineHolding[]

  @@map("portfolio_baselines")
}

/// One imported position as of the baseline date. Never updated after the
/// baseline is created — a correction goes through BaselineAdminService,
/// which replaces the full set for the baseline rather than patching a row,
/// so there is never a partially-corrected baseline visible to a reader.
model BaselineHolding {
  id         String            @id @default(cuid()) @map("_id")
  baselineId String
  baseline   PortfolioBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  ticker      String
  quantity    Float
  averageCost Float
  currency    String
  sector      String
  industry    String

  @@index([baselineId])
  @@map("baseline_holdings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fee billing history — see ReportsService.
// ─────────────────────────────────────────────────────────────────────────────

/// One client's management fee for one closed calendar quarter, frozen at the
/// moment the quarter closed.
///
/// This exists because every input to a fee is mutable but an invoice is not.
/// `Client.feeRatePercent` is a single current-value column with no history: if
/// a mandate renegotiates 2% down to 1.5%, recomputing last quarter from the
/// live client row would silently reprice an invoice that was already issued.
/// So the numbers are copied here rather than referenced — a row is a record of
/// what was billed, not a view onto what would be billed today.
///
/// Written once per (client, quarter) by ReportsService.closeQuarter, driven by
/// the same quarter-end trigger that flags PortfolioValuation.isQuarterEnd.
/// Only the CLOSED quarters live here; the in-progress quarter is computed live
/// as an estimate and deliberately never stored, because its portfolio value is
/// still moving.
model ClientFeeSchedule {
  id       String @id @default(cuid()) @map("_id")
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Canonical quarter code, e.g. "Q3-CY26" — the same vocabulary
  /// periods.ts/resolvePeriod speaks, so a fee quarter and a performance
  /// quarter can never mean different windows.
  quarter      String
  quarterLabel String
  quarterStart DateTime
  quarterEnd   DateTime

  /// Copied from Client at close, NOT read through the relation. See the note
  /// above: the client's rate may since have changed.
  feeRatePercent Float
  /// The quarter-end NAV the fee was charged on, per the Client model's stated
  /// basis ("quarterly at feeRatePercent / 4 of quarter-end portfolio value").
  portfolioValue Float

  /// Billable days, prorated from the later of (quarter start, inception).
  daysBilled   Int
  daysInQuarter Int
  feeAmount    Float

  /// Where portfolioValue came from: "snapshot" when the quarter-end
  /// PortfolioValuation row existed, "reconstruction" when the scheduler had
  /// missed that date and the value was replayed from the baseline. Recorded
  /// because the two are equally correct but not equally auditable.
  valuationSource String @default("snapshot")

  createdAt DateTime @default(now())

  /// One fee row per client per quarter — this is what makes closeQuarter
  /// idempotent and re-runnable rather than double-billing on a retry.
  @@unique([clientId, quarter])
  @@index([quarter])
  @@map("client_fee_schedules")
}
