generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid()) @map("_id")
  email        String  @unique
  firstName    String
  lastName     String
  password     String
  role         Role    @default(PORTFOLIO_MANAGER)
  avatar       String?
  active       Boolean @default(true)
  /// Firm the user belongs to, shown on the Settings > Profile tab. Free text —
  /// there is no Organization model; this is a label, not a tenancy boundary.
  organization String?

  /// Settings > Preferences. Every field is optional at the DB level so existing
  /// rows read back as null; UsersService substitutes the documented defaults
  /// (system / USD / MMM D, YYYY / en-US / comfortable) so the API always
  /// returns a fully-populated object and the UI never renders an empty select.
  theme        String?
  baseCurrency String?
  dateFormat   String?
  numberFormat String?
  density      String?

  /// Settings > Notifications. Nullable for the same reason as above: absent
  /// means "never chosen", which resolves to the default in UsersService rather
  /// than to `false` — otherwise every existing user would silently be opted out.
  notifyTradeAlerts       Boolean?
  notifyPriceTargets      Boolean?
  notifyWeeklyDigest      Boolean?
  notifyCorporateActions  Boolean?
  notifyProductUpdates    Boolean?

  /// Settings > Security, Two-Factor Authentication (TOTP).
  ///
  /// `twoFactorSecret` holds the base32 shared secret. It is written during
  /// setup — before the user has proven they can generate a code — so
  /// `twoFactorEnabled` is the only flag the login gate reads. A secret with the
  /// flag still false means "setup started but never confirmed", and is simply
  /// overwritten by the next setup attempt.
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  /// bcrypt hashes of the single-use recovery codes shown once at enrolment.
  /// Hashed for the same reason passwords are: a database leak must not hand
  /// over a working second factor. A consumed code is spliced out of the array.
  twoFactorRecoveryCodes String[] @default([])
  twoFactorEnabledAt     DateTime?

  sessions Session[]

  /// The mandates, households and tracked names this staff user owns — see
  /// Client.ownerId. Empty for a brand-new manager, which is the point: a new
  /// login starts with an empty book rather than inheriting the firm's.
  ///
  /// Back-relations only; the FK and its delete semantics live on the far side.
  ownedClients    Client[]    @relation("ClientOwner")
  ownedFamilies   Family[]    @relation("FamilyOwner")
  ownedWatchlists Watchlist[] @relation("WatchlistOwner")

  /// When set, this User is a client login (role VIEWER) created from the client
  /// add/edit form, scoped to a single mandate. Staff logins leave this null.
  ///
  /// NOT `@unique`: on MongoDB a unique index over an optional FK treats every
  /// staff row (clientId absent → indexed as null) as a duplicate, so the index
  /// can't build. One-login-per-client is enforced in ClientsService instead.
  /// Cascades: deleting the client removes its login.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// --- Seat subscription (Portfolio Managers only) ---
  ///
  /// What this manager pays the FIRM for their login. Nothing to do with
  /// ClientFeeSchedule, which is what the firm charges its investors.
  ///
  /// Every field is nullable and `subscriptionStatus` has no default on
  /// purpose: SUPER_ADMIN, RESEARCH_ANALYST and VIEWER rows are not billable
  /// seats, and a default of TRIALING would have wrongly enrolled all of them —
  /// including the client-portal logins — the moment this migration ran. Null
  /// therefore reads as "not a billable seat", which is what every pre-existing
  /// row correctly is. UsersService stamps these only when creating a manager.
  subscriptionStatus SubscriptionStatus?
  /// End of the free window, stamped at creation from AppSetting.trialDays.
  /// Once written it is never recalculated — see the note on that field.
  trialEndsAt        DateTime?
  /// Paid access runs to here. Extended by the webhook on each capture.
  currentPeriodEnd   DateTime?
  billingCycle       BillingCycle?

  /// Razorpay's customer/subscription handles, when the manager has paid at
  /// least once. Null for a manager still inside their trial.
  razorpayCustomerId     String?
  razorpaySubscriptionId String?

  payments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The expiry sweep asks "which seats lapsed", which is a status+date scan.
  @@index([subscriptionStatus])
  @@map("users")
}

/// One-time password issued for the forgot-password flow. A row is created when
/// a user requests a reset; the 6-digit code is stored hashed (never in the
/// clear), expires after a few minutes, and is deleted once consumed. Old rows
/// for the same email are cleared on each new request so only the latest is valid.
model PasswordReset {
  id        String   @id @default(cuid()) @map("_id")
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_resets")
}

/// One row per signed-in device, created when a login completes and deleted when
/// that device is revoked or signs out. This is what Settings > Security lists.
///
/// The refresh token is stored as a SHA-256 hash, not in the clear: the row's
/// whole purpose is to let a user kill a session they don't recognise, and a
/// readable token would let anyone with database access resume it instead.
/// AuthService checks every refresh against this table, so deleting the row is
/// what actually ends the session — the access token then expires on its own.
model Session {
  id     String @id @default(cuid()) @map("_id")
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the refresh token. Rotated on every successful refresh so a
  /// stolen-and-replayed token can't outlive the legitimate device's next call.
  refreshTokenHash String @unique

  /// Raw User-Agent plus what we parsed out of it, denormalized so the list
  /// endpoint doesn't re-parse on every read. Nullable: a non-browser client
  /// (curl, a test) may send no User-Agent at all.
  userAgent String?
  browser   String?
  os        String?
  ip        String?

  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

/// Staff roles, most privileged first.
///
/// SUPER_ADMIN is the only role that may manage other users — create a
/// Portfolio Manager, change someone's role, deactivate a login. It is
/// deliberately not self-assignable: a user cannot promote themselves into it
/// through the profile form, and the last remaining SUPER_ADMIN cannot be
/// demoted or deactivated, so the firm can never lock itself out.
///
/// PORTFOLIO_MANAGER is the working role. It can do everything else the app
/// offers — clients, transactions, holdings, research, reports — and differs
/// from SUPER_ADMIN only in that it cannot administer user accounts.
///
/// ADMIN predates SUPER_ADMIN and is kept so existing rows still read. It is
/// treated as equivalent to PORTFOLIO_MANAGER everywhere except the legacy
/// baseline guard, which still recognises it.
enum Role {
  SUPER_ADMIN
  ADMIN
  PORTFOLIO_MANAGER
  RESEARCH_ANALYST
  VIEWER
}

model Client {
  id            String      @id @default(cuid()) @map("_id")
  name          String
  broker        String
  accountNumber String
  /// Optional contact email for the mandate. Nullable: legacy clients predate
  /// this field. Stored lowercased/trimmed by the DTO.
  email         String?
  /// Free-text label kept for the existing CRUD UI. Analytics joins on benchmarkId
  /// instead: a string like "swderfg" cannot be joined to a price series.
  benchmark     String
  benchmarkId   String?
  riskProfile   RiskProfile

  /// Which cash flows feed this client's XIRR. See PerformanceService.
  ///
  /// CASH_FLOW    — the manager records the money the client actually handed over
  ///                and took back (CASH_DEPOSIT / CASH_WITHDRAWAL). Trades are
  ///                internal reshuffling and are NOT flows.
  /// TRANSACTIONAL — no external flow record exists; each BUY is treated as money
  ///                in and each SELL as money out, so the return is measured on
  ///                capital deployed into positions.
  ///
  /// The cash-flow method has been retired from the product: every client is now
  /// transactional. The enum value is kept so legacy records still read, but
  /// nothing writes CASH_FLOW anymore and the default for new rows is
  /// TRANSACTIONAL. See ClientsService, which forces this on every write.
  accountingMethod AccountingMethod @default(TRANSACTIONAL)

  /// Only meaningful under TRANSACTIONAL. Excluding fees gives the gross-of-fee
  /// return the manager is measured on; including them gives the net-of-fee
  /// return the client actually received. Both default ON, so the headline
  /// number is the one the client experienced.
  ///
  /// Under CASH_FLOW these are ignored — dividends and fees are already inside
  /// the terminal value there, because the cash landed in (or left) the balance.
  /// Counting them as flows as well would double-count them.
  includeDividends Boolean @default(true)
  includeFees      Boolean @default(true)

  currency       String       @default("USD")

  /// Which book of business this mandate belongs to — see common/market-scope.ts.
  ///
  /// The firm runs a US book and an Indian one out of this single database, and
  /// this is the dimension nearly every read filters on: the dashboard, holdings,
  /// performance and reports are all scoped to one market at a time via the
  /// header's country selector.
  ///
  /// Defaults to US so every client that predates the Indian book keeps reading
  /// exactly as before rather than vanishing from an unscoped query. It is NOT
  /// derived from `currency`: currency is a reporting unit that a US mandate
  /// could in principle change, whereas market determines which exchange the
  /// tickers resolve against and which indices benchmark the book.
  market         Market       @default(US)

  /// The staff user whose book this mandate sits in — the firm's privacy
  /// boundary, and the dimension every client-scoped read filters on alongside
  /// `market`. See common/ownership-scope.ts, which is the only place the rule
  /// is written down.
  ///
  /// One owner, not a list: a mandate belongs to exactly one manager, which is
  /// the rule the desk works to and what makes "no other fund manager can see
  /// other fund managers' data" expressible as a single equality filter.
  /// Co-management would be an array here plus an `in` filter in the scope
  /// helper, and nothing else — but it is deliberately not modelled today.
  ///
  /// Nullable for two reasons. MongoDB does not backfill a new field onto
  /// existing documents, so every mandate that predates ownership has no key at
  /// all (see backfill-ownership.ts). And null carries a real meaning worth
  /// keeping afterwards: an UNASSIGNED mandate, visible to Super Admins only.
  /// That is the safe direction to fail — an unowned client is invisible to
  /// every manager rather than visible to all of them.
  ///
  /// `NoAction`, emphatically NOT Cascade: deleting a departing manager's login
  /// must never take their clients' holdings, transactions and valuations with
  /// it. Reassign the book first, then delete the user.
  ///
  /// Two caveats worth stating plainly, because the annotation reads stronger
  /// than it is. Prisma demands NoAction on one edge of the
  /// Client.owner → User.client cycle, so `Restrict` was not available here.
  /// And on MongoDB neither one is enforced by the database at all — there are
  /// no foreign keys, so a referential action is at most a hint to Prisma's own
  /// query layer. The guarantee that a manager with a non-empty book cannot be
  /// deleted is therefore CODE, in UsersService.deleteUser, and that check is
  /// the only thing actually standing between a departing manager and their
  /// clients' data. Do not remove it on the strength of this annotation.
  ownerId        String?
  owner          User?        @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// The household this mandate belongs to, if any — see Family.
  ///
  /// Nullable because most mandates stand alone; only the accounts a manager
  /// has explicitly grouped carry it. Set to null (not cascaded) when the
  /// family is deleted, so dissolving a household never deletes a client.
  familyId       String?
  family         Family?      @relation(fields: [familyId], references: [id], onDelete: SetNull)

  status         ClientStatus @default(ACTIVE)
  cashBalance    Float        @default(0)
  portfolioValue Float        @default(0)
  xirr           Float        @default(0)
  notes          String?

  /// Annual management fee, as a percent (e.g. 2 for 2%). Billed quarterly at
  /// feeRatePercent / 4, prorated over capital actually deployed: the opening
  /// book bills for the whole quarter, and capital put to work mid-quarter
  /// bills only for its remaining days. A BUY on day 80 of a 92-day quarter is
  /// charged 12 days, not the full quarter — see fee-proration.ts for the
  /// method and why quarter-end NAV alone could not express it. Defaulted for
  /// clients created before this field existed; required on create going forward.
  feeRatePercent Float    @default(0)
  /// The mandate's actual start date, used to prorate the first (partial)
  /// billing quarter. NOT the same as createdAt, which is only when the
  /// record was entered into Giriraj Global Consultants and may postdate real inception for
  /// backfilled clients. Defaults to createdAt's value at write time for
  /// clients created before this field existed.
  inceptionDate  DateTime @default(now())

  holdings     Holding[]
  transactions Transaction[]
  research     Research[]

  /// The client's own login account(s) (role VIEWER), if one was set from the
  /// add/edit form. Modeled as a list because the FK isn't a unique index on
  /// MongoDB (see User.clientId), but ClientsService keeps it to at most one.
  loginUsers User[]

  /// The immutable legacy import baseline (see PortfolioBaseline). Not
  /// `@unique` here — the one-per-client rule is a Prisma-relation-field
  /// convenience only; PortfolioBaseline.clientId carries the real @unique
  /// constraint that enforces it at the database level.
  baseline   PortfolioBaseline?
  /// Historical daily NAV rows written by the snapshot scheduler — see
  /// PortfolioHistoryService. Empty until the first snapshot runs for this
  /// client.
  valuations PortfolioValuation[]
  /// Frozen per-quarter fee records, one per CLOSED quarter. Note that these
  /// carry their own copy of feeRatePercent: editing the rate above changes
  /// future billing only, never a quarter already closed.
  feeSchedules ClientFeeSchedule[]

  /// Every corporate action that has touched this mandate — one row per action
  /// applied, never deleted (see CorporateActionLedger).
  corporateActionLedger CorporateActionLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([name])
  /// Every market-scoped read starts `market = ?`, usually alongside a status
  /// filter — a compound index keeps that from scanning the whole collection
  /// once the second book grows.
  @@index([market, status])
  /// A manager's scoped list is `ownerId = ? AND market = ?`. Ownership leads
  /// because it is the most selective of the two — one manager's book is a
  /// small slice of a market, never the other way round — and because it is
  /// present on every scoped read while `market` is optional on some.
  @@index([ownerId, market])
  /// "Whose book is this in", and the reassignment sweep when a manager leaves.
  @@index([ownerId])
  /// The family aggregate reads every member in one query.
  @@index([familyId])
  @@map("clients")
}

enum RiskProfile {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

enum AccountingMethod {
  TRANSACTIONAL
  CASH_FLOW
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

/// The book of business a client or instrument belongs to. Adding a market here
/// plus an entry in common/market-scope.ts is the whole change needed to run a
/// third book — no service reads a hardcoded exchange or currency.
enum Market {
  US
  INDIA
}

model Holding {
  id       String @id @default(cuid()) @map("_id")
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ticker   String
  company  String
  sector   String
  industry String
  country  String
  theme    String?
  exchange String

  quantity          Float
  averageCost       Float
  currentPrice      Float
  marketValue       Float
  allocationPercent Float @default(0)
  unrealizedPnL     Float @default(0)
  realizedPnL       Float @default(0)
  dividend          Float @default(0)
  weight            Float @default(0)
  targetWeight      Float @default(0)
  holdingDays       Int   @default(0)

  investmentThesis String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, ticker])
  @@index([clientId])
  @@index([ticker])
  @@index([sector])
  @@map("holdings")
}

model Transaction {
  id       String @id @default(cuid()) @map("_id")
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ticker      String?
  type        TransactionType
  quantity    Float?
  price       Float?
  amount      Float
  date        DateTime
  description String?
  reference   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([ticker])
  @@index([date])
  /// The valuation replay issues `clientId = ? AND date <= ?` once per client.
  /// Separate single-field indexes make Mongo pick one and scan the rest.
  @@index([clientId, date])
  @@map("transactions")
}

/// Ledger row kinds.
///
/// The first nine values predate the Corporate Action Engine and their replay
/// semantics in PortfolioReconstructionService are load-bearing for Historical
/// Reports and Performance — none of them may change meaning.
///
/// Everything from CORPORATE_ACTION down is written ONLY by a corporate-action
/// processor. They share one rule that separates them from BUY/SELL: a
/// corporate action is not a trade. Where such a row carries `quantity` it is
/// the ADDITIONAL (delta) share count, never the post-action total, and its
/// `amount` is 0 unless real cash moved. That convention is what lets the
/// existing replay treat a split as economically neutral — quantity rises,
/// cost basis total does not, so average cost falls out arithmetically and no
/// artificial return is created (see PART 26/52 of the engine spec).
enum TransactionType {
  BUY
  SELL
  DIVIDEND
  SPLIT
  BONUS
  TRANSFER
  CASH_DEPOSIT
  CASH_WITHDRAWAL
  FEES

  // ── Corporate-action rows ────────────────────────────────────────────────
  /// Umbrella kind for an action with no more specific row type.
  CORPORATE_ACTION
  /// Share-count decrease from a reverse split. `quantity` is NEGATIVE delta.
  REVERSE_SPLIT
  SPECIAL_DIVIDEND
  /// Rights ACCRUED to the holder. Carries no shares and no cash — it records
  /// an entitlement the client may or may not take up (PART 16).
  RIGHTS_ENTITLEMENT
  /// The client actually subscribed: cash out, shares in.
  RIGHTS_SUBSCRIPTION
  /// Shares of a NEW security received from a parent. Zero cost unless a
  /// basis-allocation policy is configured.
  SPINOFF
  /// Share leg of a merger/acquisition — the outgoing position is closed and
  /// the incoming one opened at carried-over basis.
  MERGER
  ACQUISITION
  /// Symbol relabelling only. Never changes quantity, basis or cash; exists so
  /// the ledger shows WHY a symbol differs either side of a date (PART 19).
  TICKER_CHANGE
  /// Cash paid for a fractional entitlement that could not be issued (PART 11).
  CASH_IN_LIEU
  DELISTING_SETTLEMENT
  /// Cash distribution / return of capital (PART 15 cash leg, PART 16 of the
  /// action list). Return of capital reduces basis rather than booking income.
  RETURN_OF_CAPITAL
}

model Research {
  id       String  @id @default(cuid()) @map("_id")
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ticker           String
  investmentThesis String?
  whyBought        String?
  catalysts        String?
  risks            String?
  valuation        String?
  targetAllocation Float?
  targetPrice      Float?
  reviewDate       DateTime?
  reviewNotes      String?
  attachments      String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticker])
  @@index([clientId])
  @@map("research")
}

/// A tracked ticker with no priority/status workflow — returns (MTD/QTD/YTD)
/// are computed live from market data, not stored here. `slot` is one of five
/// fixed lists ("1".."5") a ticker can be placed on; the same ticker may
/// appear on more than one list.
model Watchlist {
  id       String @id @default(cuid()) @map("_id")
  slot     String @default("1")
  ticker   String
  company  String
  sector   String
  industry String

  /// Which book this tracked name belongs to.
  ///
  /// Scoped like every other read: switching the header's country selector to
  /// India shows the Indian watchlist, not a mixed table. That matters here more
  /// than elsewhere because the price column is rendered in the selected book's
  /// currency — a US name sitting in the Indian list would read as rupees.
  ///
  /// Defaults to US so every ticker added before the Indian book keeps showing
  /// on the US watchlist rather than vanishing from both.
  market   Market @default(US)

  /// The manager whose watchlist this row belongs to. Each manager keeps their
  /// own five slots; the list is a working research tool, and one manager's
  /// candidates are a signal about their book.
  ///
  /// Null means a pre-ownership row, migrated to the owning manager by
  /// backfill-ownership.ts. Unlike Client, an unowned watchlist row is harmless
  /// — it holds a ticker, not client data.
  /// Cascade is genuinely wanted here — a departed manager's tracked tickers
  /// carry no client data and are worth nothing to anyone else. Unlike Client
  /// and Family, MongoDB's lack of FK enforcement means this too is executed by
  /// Prisma's query layer rather than the database, so UsersService clears
  /// these rows explicitly when deleting a manager.
  ownerId String?
  owner   User?  @relation("WatchlistOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Scoped per book: the same ticker may sit on slot 1 of both books, and
  /// (more to the point) 'RELIANCE.NS' and a US name never collide.
  ///
  /// NOT widened to include ownerId, for the MongoDB optional-field reason
  /// given on Family.name — an index over a nullable key cannot build here.
  /// The practical consequence is real and accepted: two managers cannot hold
  /// the same ticker on the same slot of the same book. WatchlistService
  /// therefore keys its add/remove on (ownerId, market, slot, ticker) and
  /// enforces per-manager uniqueness in code, exactly as ClientsService already
  /// enforces one-login-per-client that User.clientId cannot express.
  @@unique([market, slot, ticker])
  @@index([market, slot])
  @@index([ownerId, market, slot])
  @@map("watchlists")
}

/// Display name for each of the five watchlist slots. Rows are created
/// lazily (upsert) the first time a slot's name is changed from its default.
///
/// Named per book, so the Indian book's "Slot 1" can be "Nifty Compounders"
/// while the US book's stays "Core Longs".
///
/// Named per MANAGER too, since the watchlist itself is per-manager: without
/// an owner here, one manager renaming a slot would silently relabel every
/// other manager's sidebar.
model WatchlistFolder {
  id     String @id @default(cuid()) @map("_id")
  slot   String
  name   String
  market Market @default(US)

  /// Null means the pre-ownership firm-wide name, which the service falls back
  /// to when this manager has not renamed the slot themselves — so existing
  /// folder names keep showing instead of reverting to "Slot 1" for everyone.
  ownerId String?

  /// `ownerId` is intentionally a plain column with no relation: this table is
  /// a label store that no cascade should ever touch, and adding a fourth
  /// back-relation to User for five strings per manager is not worth it.
  ///
  /// The unique key stays (market, slot) for the MongoDB nullable-key reason
  /// documented on Watchlist. Per-owner naming is therefore enforced in
  /// WatchlistService, which resolves a rename to the caller's own row.
  @@unique([market, slot])
  @@index([ownerId, market])
  @@map("watchlist_folders")
}

/// A household — several client mandates managed as one book.
///
/// The Indian desk in particular runs four or five accounts that belong to one
/// family (a couple, their children, an HUF), and the manager reasons about the
/// household's combined exposure: how much of RELIANCE the family holds in
/// total, at what blended cost, and how the sector mix looks once the accounts
/// are merged. Individual mandates stay first-class — this groups them for
/// reporting, it does not merge them.
///
/// Membership is a nullable FK on Client rather than a join table: a client
/// belongs to at most one family, and that is the rule the desk actually works
/// to. Deleting a family leaves its clients intact and unaffiliated
/// (onDelete: SetNull), because a household dissolving must never take the
/// underlying mandates' holdings with it.
model Family {
  id   String @id @default(cuid()) @map("_id")
  name String

  /// A family lives in ONE book. Aggregating an INR mandate with a USD one
  /// would sum two different units into a meaningless total, and the codebase
  /// carries no FX rate to convert between them — so the API rejects a member
  /// from another book rather than silently producing a wrong number.
  market Market @default(US)

  /// The manager whose book this household sits in — same boundary and same
  /// delete semantics as Client.ownerId.
  ///
  /// A household groups mandates, so an unscoped family would leak the client
  /// names inside it across managers even while the underlying clients stayed
  /// hidden. A family and its members must therefore share an owner; the
  /// service enforces that on membership changes the same way it already
  /// enforces a shared market.
  /// `NoAction` rather than `Restrict` only because Prisma requires one edge of
  /// the cycle Client.family → Family.owner → User.client → Client.family to
  /// opt out of referential actions. The two behave identically on MongoDB,
  /// which has no foreign keys to enforce either way: deleting a manager who
  /// still owns households is blocked in UsersService, not by the database.
  ownerId String?
  owner   User?  @relation("FamilyOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  notes String?

  clients Client[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Families are listed per book, and a household name is unique within one.
  ///
  /// Deliberately NOT widened to include ownerId. Two managers cannot both name
  /// a household "Salecha Family" — but that collision is vanishingly rare next
  /// to the cost of the alternative: on MongoDB a unique index whose key
  /// includes an optional field treats every unstamped row (ownerId absent) as
  /// a duplicate, so the index would fail to build against the existing data
  /// this migration is designed to preserve. Same reasoning as User.clientId.
  @@unique([market, name])
  @@index([market])
  @@index([ownerId, market])
  @@map("families")
}

// ─────────────────────────────────────────────────────────────────────────────
// Analytics engine — see ANALYTICS_ARCHITECTURE.md
// ─────────────────────────────────────────────────────────────────────────────

/// Daily bars for every instrument AND every benchmark. Benchmarks are ordinary
/// symbols (^GSPC, ^IXIC) rather than a separate table, so "beta vs the S&P" and
/// "beta vs a peer stock" are the same code path.
///
/// Without this collection there is no return series, and Beta/Sharpe/Sortino/
/// drawdown/attribution cannot be computed at all.
model PriceBar {
  id       String   @id @default(cuid()) @map("_id")
  symbol   String
  date     DateTime
  open     Float?
  high     Float?
  low      Float?
  close    Float
  /// Split- and dividend-adjusted. Returns are ALWAYS computed from this, never
  /// from `close` — using close makes every stock that paid a dividend look like
  /// it crashed on the ex-date.
  adjClose Float
  volume   Float?
  /// "yahoo" | "workbook" | "manual" — provenance stays auditable.
  source   String

  createdAt DateTime @default(now())

  /// Doubles as the range-scan index every risk calc issues, and as the idempotent
  /// upsert key that makes backfill safely re-runnable.
  @@unique([symbol, date])
  @@map("price_bars")
}

/// Named benchmarks. Client.benchmark is free text today (the live value is
/// literally "swderfg"), and free text cannot drive a calculation.
model Benchmark {
  id        String  @id @default(cuid()) @map("_id")
  code      String  @unique
  name      String
  /// Join key into PriceBar.symbol.
  symbol    String
  /// Which book this benchmark belongs to, so the client form offers Nifty/Sensex
  /// for an Indian mandate and the S&P/Nasdaq for a US one. `isDefault` is scoped
  /// by market too — each book has its own default (S&P 500 / Nifty 50).
  market    Market  @default(US)
  isDefault Boolean @default(false)

  @@index([market])
  @@map("benchmarks")
}

/// One row per instrument. Today sector/industry/country are copied onto every
/// holding row of every client, so reclassifying one ticker is an N-client write
/// and any partial failure leaves the house-level rollup inconsistent with itself.
model InstrumentProfile {
  id         String     @id @default(cuid()) @map("_id")
  symbol     String     @unique
  company    String
  assetClass AssetClass @default(EQUITY)
  sector     String     @default("Unclassified")
  industry   String     @default("Unclassified")
  /// Domicile of the ISSUER. For a US-listed China ETF this is "United States",
  /// which is exactly why lookThrough exists.
  country    String     @default("Unknown")
  region     String     @default("Unknown")
  exchange   String     @default("Unknown")
  currency   String     @default("USD")

  /// Which book this instrument trades in, derived from the Yahoo suffix
  /// ('.NS'/'.BO' → INDIA, otherwise US) by marketForSymbol(). Stored rather
  /// than re-derived on every read so exposure rollups can group by it without
  /// parsing strings, and so a future market whose symbols are NOT
  /// suffix-distinguishable can be corrected by hand.
  market     Market     @default(US)

  /// ETF decomposition: { region: [{ key: "China", weight: 1 }], sector: [...] }.
  /// Null for single stocks. Without this, a book holding MCHI reports 0% China
  /// exposure, because Yahoo classifies the fund itself as US-domiciled.
  lookThrough Json?

  source     String    @default("manual")
  /// Set when a human sets the classification. The nightly Yahoo sync must not
  /// overwrite a considered manual decision.
  reviewedAt DateTime?

  // ── Security-master identity (Corporate Action Engine, PART 46) ───────────
  //
  // A ticker is not an identity: it changes at a rename, and it is REUSED by
  // unrelated issuers afterwards. Corporate actions therefore reference this
  // row's `id` where one exists, and these codes are what let a profile
  // survive its own symbol changing.
  //
  // All optional, and deliberately so. InstrumentProfile is populated by the
  // workbook importer and so today covers the US book alone — every Indian
  // symbol is absent. A REQUIRED identifier here would make an Indian
  // corporate action unstorable, which is why CorporateAction.securityId is a
  // soft reference and `symbol` remains the resolution key that always works.
  /// 12-character ISIN, the globally unique instrument identifier.
  isin String?
  /// 9-character CUSIP. North America only; null for Indian listings.
  cusip String?
  /// Symbols this instrument previously traded under, appended by
  /// TickerChangeProcessor. Lets a historical row written as 'FB' still resolve
  /// to the profile now called 'META' without rewriting accounting history.
  previousSymbols String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sector])
  @@index([region])
  @@index([market])
  @@index([isin])
  @@map("instrument_profiles")
}

enum AssetClass {
  EQUITY
  ETF
  FUND
  CASH_EQUIV
}

/// Daily NAV per client. PriceBar gives instrument history; this gives PORTFOLIO
/// history, which is what risk/drawdown/XIRR actually consume.
model PortfolioValuation {
  id       String   @id @default(cuid()) @map("_id")
  clientId String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date     DateTime

  securitiesValue Float
  cashValue       Float
  totalValue      Float

  /// EXTERNAL flows only (deposits/withdrawals). A BUY moves cash into securities
  /// inside the portfolio and leaves NAV unchanged — counting it here would
  /// double-count and corrupt the return.
  netFlow Float @default(0)

  /// Flow-adjusted: (V_t - V_{t-1} - F_t) / V_{t-1}. Stored rather than derived on
  /// read because every risk metric scans this column, and recomputing it needs
  /// that day's flows from another collection.
  dailyReturn Float @default(0)

  positionCount Int     @default(0)
  /// Marks days where a price had to be carried forward. Stale days are excluded
  /// from volatility — a stale price makes risk read artificially LOW.
  stale         Boolean @default(false)
  source        String  @default("eod-job")

  /// Sum of quantity * averageCost across positions as of `date` — the
  /// accounting-cost figure, distinct from `totalValue` (market value). Used by
  /// gain/loss reporting; never fed into performance-return math.
  totalCost Float @default(0)
  /// totalValue's securities leg minus totalCost. Derived at write time and
  /// cached here so historical reports don't need a live replay to show it.
  unrealizedPnL Float @default(0)
  /// Cumulative realized gain from every SELL replayed up to and including
  /// `date`. Cumulative (not "since last snapshot") so any single row is a
  /// complete answer on its own.
  realizedPnL Float @default(0)
  /// Benchmark value on the same unit-purchase basis as PerformanceService,
  /// valued as of `date`. Null until a benchmark is resolved for the client.
  benchmarkValue Float?
  /// Portfolio XIRR as of `date`, using PortfolioHistoryService's own flow
  /// build (not PerformanceService's) — see PortfolioHistoryService for why
  /// the two are computed independently rather than sharing one call site.
  xirr Float?
  /// True only for the row the quarter-end scheduler wrote (or backfilled) for
  /// a given quarter. A quarter can also acquire an ordinary daily row on the
  /// same date before the scheduler runs; the scheduler upserts and sets this
  /// flag rather than assuming its row is the first to exist for that date.
  isQuarterEnd Boolean @default(false)

  holdings HoldingSnapshot[]

  createdAt DateTime @default(now())

  @@unique([clientId, date])
  @@map("portfolio_valuations")
}

/// One row = one position's state on a specific PortfolioValuation date. Together
/// with its parent this is the full "portfolio as it existed on that day" record
/// that PortfolioHistoryService reads before falling back to a live reconstruction
/// (see PART 7 in the architecture note / PortfolioHistoryService.getPortfolioAsOf).
///
/// Written once, atomically, alongside its parent PortfolioValuation row and never
/// edited afterward — a re-run of the snapshot job deletes and reinserts the full
/// set for that date rather than patching individual rows, so there is never a
/// partial write visible to a reader.
model HoldingSnapshot {
  id         String             @id @default(cuid()) @map("_id")
  snapshotId String
  snapshot   PortfolioValuation @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  ticker       String
  quantity     Float
  averageCost  Float
  closingPrice Float
  marketValue  Float
  /// Weight against the parent snapshot's totalValue (TOTAL_ASSETS basis, matching
  /// weights.ts elsewhere in the codebase).
  allocation Float
  sector     String
  industry   String
  /// Not in the original Part 6 field list, but needed so a snapshot-served
  /// read (PortfolioHistoryService.getPortfolioAsOf) can rebuild country and
  /// asset allocation from stored data alone — without them, a snapshot-served
  /// date silently returns empty breakdowns while a reconstructed one doesn't,
  /// breaking "the user should not know whether Snapshot or Reconstruction was
  /// used" (PART 7).
  country    String @default("Unknown")
  assetClass String @default("EQUITY")

  createdAt DateTime @default(now())

  @@index([snapshotId])
  @@map("holding_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fundamentals Engine — see FUNDAMENTALS_ARCHITECTURE.md
//
// Three collections, one direction of dependency: FundamentalSnapshot (raw,
// provider-sourced) -> ScoringRule (operator-authored, provider-agnostic) ->
// FundamentalScore (derived, cached). Nothing here is read by any of the
// modules listed as already-existing (Holdings, Dashboard, Transactions,
// Performance, Reports, Live Prices, Portfolio Analytics) and nothing here
// reads from them either — the engine is additive.
// ─────────────────────────────────────────────────────────────────────────────

/// One symbol's raw fundamental data, as last fetched from the active provider.
/// This is the ONLY collection a provider adapter is allowed to write to —
/// everything downstream (scoring, industry comparison, explanations) reads
/// this shape and never touches the provider's response directly, which is
/// what makes swapping FMP for Finnhub/AlphaVantage/Polygon a provider-layer
/// change only.
model FundamentalSnapshot {
  id     String @id @default(cuid()) @map("_id")
  symbol String @unique

  // ── Company information ────────────────────────────────────────────────
  company   String
  sector    String @default("Unclassified")
  industry  String @default("Unclassified")
  marketCap Float?

  // ── Valuation ───────────────────────────────────────────────────────────
  peRatio         Float?
  forwardPe       Float?
  pegRatio        Float?
  evToEbitda      Float?
  priceToSales    Float?
  priceToBook     Float?
  enterpriseValue Float?

  // ── Growth ──────────────────────────────────────────────────────────────
  revenueQoqPercent   Float?
  revenueYoyPercent   Float?
  netProfitQoqPercent Float?
  netProfitYoyPercent Float?
  revenueCagr3y       Float?
  netProfitCagr3y     Float?

  // ── Profitability ───────────────────────────────────────────────────────
  roe             Float?
  roic            Float?
  grossMargin     Float?
  operatingMargin Float?
  netMargin       Float?

  // ── Financial strength ──────────────────────────────────────────────────
  debtToEquity     Float?
  currentRatio     Float?
  interestCoverage Float?
  freeCashFlow     Float?

  // ── Momentum ────────────────────────────────────────────────────────────
  /// Average of the last up-to-4 quarters' (actual - estimated) / |estimated|,
  /// as a percent. Null when the provider has no estimate to compare against.
  lastFourEarningsBeatPercent Float?
  nextEarningsDate            DateTime?
  /// Derived at read time from nextEarningsDate in the service layer, NOT
  /// stored — "days until" only means something relative to today, and
  /// storing it would go stale the moment a day passes without a refresh.

  // ── Dividend ────────────────────────────────────────────────────────────
  dividendYield    Float?
  dividendPerShare Float?
  exDividendDate   DateTime?
  paymentDate      DateTime?

  /// "fmp" today; any adapter implementing FundamentalsProvider sets its own key.
  source      String   @default("fmp")
  refreshedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sector])
  @@index([industry])
  @@map("fundamental_snapshots")
}

/// One row = one banded rule for one metric under one strategy. The scoring
/// engine is ONLY this table plus a range lookup — there is deliberately no
/// switch/if-chain in code mapping a metric name to a score. Adding a new
/// factor, re-tuning a band, or authoring an entirely new strategy (Growth,
/// Value, Quality, Dividend, Small Cap, AI, ...) is a data change: insert
/// rows here, restart nothing, ship nothing.
///
/// A metric's rows within one strategy must tile the number line with no gaps
/// and no overlaps for the engine to always find exactly one match; the seed
/// data follows that convention but it is not (and cannot be) enforced by the
/// database schema itself, so treat it as a contract for anyone authoring rules.
model ScoringRule {
  id String @id @default(cuid()) @map("_id")

  /// e.g. "Revenue YoY", "ROIC", "PE vs Industry" — must match the key the
  /// ScoringEngine looks up for that pillar's metric. See scoring-metrics.ts.
  metricName   String
  minimumValue Float
  maximumValue Float
  /// Points awarded [0..100] when the metric falls in [minimumValue, maximumValue).
  score        Float
  /// This metric's weight (points out of the pillar's total) under this strategy.
  /// Duplicated on every band row for the same metric+strategy by design —
  /// weight is a property of the METRIC, banding is a property of the VALUE,
  /// and keeping them on one row is what lets the engine compute
  /// `score/100 * weight` from a single matched record with no join.
  weight       Float
  /// "GARP" | "Growth" | "Value" | "Quality" | "Dividend" | "Small Cap" | "AI" | ...
  /// Free text on purpose: a brand-new strategy is rows with a new string here,
  /// never a schema migration or an enum change.
  strategy     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([strategy, metricName])
  @@map("scoring_rules")
}

/// One symbol's computed GGC Fundamental Score under one strategy, cached so
/// the watchlist doesn't re-run five pillars' worth of rule lookups on every
/// render. Recomputed by the same daily refresh that pulls fresh snapshots,
/// and on demand if a caller asks for a symbol/strategy pair with no cache row.
model FundamentalScore {
  id       String @id @default(cuid()) @map("_id")
  symbol   String
  /// Matches ScoringRule.strategy — one symbol can be scored under several
  /// strategies at once (e.g. both "GARP" and "Growth") without collision.
  strategy String

  overallScore           Float
  growthScore            Float
  profitabilityScore     Float
  financialStrengthScore Float
  valuationScore         Float
  momentumScore          Float

  /// Per-metric breakdown: [{ metric, value, matchedRange, score, weight,
  /// contribution, pillar }, ...]. This is what powers the "hover for full
  /// breakdown" requirement — the UI renders this directly rather than
  /// re-deriving it, so the tooltip can never disagree with the number
  /// next to it.
  breakdown Json

  /// { strengths: string[], weaknesses: string[] } — see ExplanationEngine.
  explanation Json

  industryComparison Json?

  computedAt DateTime @default(now())

  @@unique([symbol, strategy])
  @@index([strategy, overallScore])
  @@map("fundamental_scores")
}

/// One row = one upcoming corporate event (earnings / dividend / split) as last
/// fetched from FMP's date-ranged calendars. The Event Center reads THIS, never
/// FMP directly, so the page keeps working when the FMP request budget is
/// exhausted or the process just restarted — same durability the Fundamentals
/// Engine gets from FundamentalSnapshot. A manual refresh (POST /events/refresh)
/// re-fetches the calendars and upserts these rows; nothing else writes here.
///
/// company / clientCount are deliberately NOT stored — they belong to Holding
/// and would drift the moment a position changes. The service joins them on at
/// read time. `ticker + type + date` is the natural key: FMP can list at most
/// one event of a given type per ticker per day.
model EventSnapshot {
  id     String @id @default(cuid()) @map("_id")
  ticker String
  /// "EARNINGS" | "DIVIDEND" | "SPLIT" — matches WatchlistEventType.
  type   String
  /// "E" | "D" | "C" badge code, carried through from the source event.
  code   String
  label  String
  /// ISO date (YYYY-MM-DD) the event falls on.
  date   String
  /// "Upcoming" | "Confirmed".
  status String

  /// Per-share ANNUAL dividend rate in the ticker's own currency, null for
  /// earnings/splits and for payers the upstream has no rate for. Annual
  /// rather than per-payment because that is what the upstream reports; see
  /// WatchlistEvent.dividendRate.
  dividendRate Float?
  /// Payments per year (1/2/4/12), inferred from the trailing yield. Null when
  /// it could not be determined, which suppresses the per-payment estimate.
  payoutsPerYear Int?

  source      String   @default("fmp")
  refreshedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ticker, type, date])
  @@index([ticker])
  @@map("event_snapshots")
}

/// One news item or exchange filing for a tracked ticker — the News Center's
/// durable store.
///
/// Same DB-first contract as EventSnapshot: the page reads only these rows and
/// never calls upstream, so it renders instantly and survives Yahoo throttling
/// or a BSE outage. NewsRefreshService is the only writer.
///
/// Unlike EventSnapshot this is NOT replace-all. News is an append-only
/// timeline: a story published last week stays true after it falls out of the
/// upstream's current window, and wiping the table on every refresh would make
/// the feed amnesiac — an advisor scrolling back a fortnight would find
/// nothing. Rows are upserted on `url` and pruned by age instead.
///
/// `ticker` is the normalized Yahoo-style symbol (RELIANCE.NS / AAPL) so it
/// joins directly against Holding.ticker and Watchlist.ticker with no mapping.
model NewsArticle {
  id     String @id @default(cuid()) @map("_id")
  ticker String
  /// Which book the ticker trades in, so the feed is scoped like every other
  /// read and an Indian review never surfaces a US headline.
  market Market

  title     String
  /// Publisher / news outlet ("Reuters"), or "BSE" for an exchange filing.
  publisher String
  /// Canonical link. Also the dedupe key: the same story reaching us from two
  /// upstreams (a BSE filing and the Reuters write-up of it) is two distinct
  /// rows, but one story fetched twice is one row.
  url       String @unique
  /// Short teaser. Null when the upstream gives only a headline.
  summary   String?

  /// When the story was published upstream — the timeline is ordered on this,
  /// never on refreshedAt, so a re-fetch cannot reshuffle the feed.
  publishedAt DateTime

  /// "NEWS" (press coverage) | "FILING" (regulator-filed disclosure).
  /// Filings are authoritative and are badged differently in the UI.
  kind String @default("NEWS")

  /// Filing category straight from the exchange ("Board Meeting",
  /// "Corp. Action", "AGM/EGM"). Null for press articles.
  category String?

  /// Materiality tag derived from the headline — "RESULTS", "BUYBACK",
  /// "M&A", "DIVIDEND", "MANAGEMENT", "RATING", "ORDER". Null when nothing
  /// matched, which is the common case and means "general coverage".
  tag String?

  /// "yahoo" | "bse" | "google-news".
  source      String
  refreshedAt DateTime @default(now())

  createdAt DateTime @default(now())

  /// The feed query: one book, newest first.
  @@index([market, publishedAt])
  /// The per-symbol drill-down.
  @@index([ticker, publishedAt])
  @@map("news_articles")
}

/// NSE-style ticker → BSE scrip code, the mapping the BSE announcements API
/// needs (it keys on 500325, not "RELIANCE").
///
/// Persisted rather than resolved per refresh because BSE's search endpoint is
/// an undocumented autocomplete: slow, rate-sensitive, and occasionally
/// ambiguous ("RELIANCE" also matches Reliance Infrastructure). Resolving once
/// and storing the answer keeps the refresh loop to one request per ticker.
///
/// `verified` marks a mapping a human confirmed, which is what makes the
/// automatic resolution safe: a wrong auto-match can be corrected and will
/// never be silently overwritten by a later refresh.
model BseScripCode {
  id     String @id @default(cuid()) @map("_id")
  /// Normalized Yahoo-style symbol, e.g. "RELIANCE.NS".
  ticker String @unique
  /// BSE scrip code, e.g. "500325".
  scripCode String
  /// Company name as BSE spells it — shown when confirming an ambiguous match.
  bseName   String?
  /// True once a human has confirmed it; auto-resolved rows start false.
  verified  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bse_scrip_codes")
}

/// Precomputed rollups. MongoDB has no GROUP BY across relations, so house-level
/// analytics are computed once by the nightly job rather than aggregated on every
/// read. This is the concession that makes 1000+ clients viable on Mongo; it costs
/// eventual consistency on house figures.
model AnalyticsCache {
  id        String   @id @default(cuid()) @map("_id")
  /// "house" | "client:<id>" | "overlap"
  scope     String
  metric    String
  asOf      DateTime
  payload   Json
  /// Fingerprint of the inputs, including a calcVersion that is bumped whenever a
  /// calculator's logic changes — otherwise a fixed formula keeps serving stale
  /// wrong numbers from cache, invisibly.
  inputHash String

  computedAt DateTime @default(now())

  @@unique([scope, metric, asOf])
  @@index([scope, asOf])
  @@map("analytics_cache")
}

// ─────────────────────────────────────────────────────────────────────────────
// Legacy Portfolio Baseline & Historical Reconstruction
//
// Real transaction history before the baseline date does not exist — clients
// were bulk-imported as a snapshot of positions on a single date. Everything
// from that date forward IS tracked transactionally in the existing
// Transaction table. PortfolioReconstructionService replays Transaction rows
// on top of BaselineHolding[] to answer "what did this portfolio look like on
// date X", for any X after the baseline; PortfolioHistoryService caches that
// answer as a PortfolioValuation + HoldingSnapshot[] row so most historical
// reads don't require a full replay.
// ─────────────────────────────────────────────────────────────────────────────

/// The immutable opening position for one client — what was imported before
/// the system started recording transactions. Exactly one per client, and normally
/// never touched again after creation: `@unique` on `clientId` is the database
/// half of that guarantee, and BaselineService exposes no update method at all.
/// The only path that can change a locked baseline is BaselineAdminService,
/// gated to ADMIN and required to append to `remarks` rather than overwrite —
/// see that service for the audit-trail rationale.
model PortfolioBaseline {
  id       String @id @default(cuid()) @map("_id")
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// e.g. 2026-06-30. PortfolioReconstructionService refuses to reconstruct any
  /// date before this one — there is nothing to replay onto.
  baselineDate          DateTime
  openingPortfolioValue Float
  openingCash           Float
  remarks               String?

  createdAt DateTime  @default(now())
  /// User id of whoever created (or, via BaselineAdminService, amended) this
  /// row. Not a relation: the creating user may later be deactivated, and the
  /// baseline must still show who set it.
  createdBy String?
  /// Set once the baseline is confirmed correct. Null briefly covers the
  /// window between import and manual confirmation; BaselineService.create()
  /// currently sets it immediately, but the field exists so a future
  /// "review before locking" step doesn't need a migration.
  lockedAt  DateTime?

  holdings BaselineHolding[]

  @@map("portfolio_baselines")
}

/// One imported position as of the baseline date. Never updated after the
/// baseline is created — a correction goes through BaselineAdminService,
/// which replaces the full set for the baseline rather than patching a row,
/// so there is never a partially-corrected baseline visible to a reader.
model BaselineHolding {
  id         String            @id @default(cuid()) @map("_id")
  baselineId String
  baseline   PortfolioBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  ticker      String
  quantity    Float
  averageCost Float
  currency    String
  sector      String
  industry    String

  @@index([baselineId])
  @@map("baseline_holdings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fee billing history — see ReportsService.
// ─────────────────────────────────────────────────────────────────────────────

/// One client's management fee for one closed calendar quarter, frozen at the
/// moment the quarter closed.
///
/// This exists because every input to a fee is mutable but an invoice is not.
/// `Client.feeRatePercent` is a single current-value column with no history: if
/// a mandate renegotiates 2% down to 1.5%, recomputing last quarter from the
/// live client row would silently reprice an invoice that was already issued.
/// So the numbers are copied here rather than referenced — a row is a record of
/// what was billed, not a view onto what would be billed today.
///
/// Written once per (client, quarter) by ReportsService.closeQuarter, driven by
/// the same quarter-end trigger that flags PortfolioValuation.isQuarterEnd.
/// Only the CLOSED quarters live here; the in-progress quarter is computed live
/// as an estimate and deliberately never stored, because its portfolio value is
/// still moving.
model ClientFeeSchedule {
  id       String @id @default(cuid()) @map("_id")
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Canonical quarter code, e.g. "Q3-CY26" — the same vocabulary
  /// periods.ts/resolvePeriod speaks, so a fee quarter and a performance
  /// quarter can never mean different windows.
  quarter      String
  quarterLabel String
  quarterStart DateTime
  quarterEnd   DateTime

  /// Copied from Client at close, NOT read through the relation. See the note
  /// above: the client's rate may since have changed.
  feeRatePercent Float
  /// The capital the fee was charged against: opening book plus net capital
  /// deployed during the quarter. NOT simply quarter-end NAV — market movement
  /// on already-billed capital does not change the base, only client
  /// deployment does. See AnalyticsCalculators/fee-proration.ts.
  portfolioValue Float

  /// Portfolio value at the quarter's start, before this quarter's trades.
  /// The base the first fee segment bills on. Nullable: rows frozen before
  /// segmented proration shipped have no opening figure to report, and a 0
  /// there would read as "the book was empty" rather than "not recorded".
  openingValue Float?

  /// Why the fee is the number it is: one entry per billed component — the
  /// opening book, then each day capital was net deployed or withdrawn —
  /// each carrying its amount, days billed and resulting fee. See FeeSegment.
  ///
  /// Frozen with the row rather than recomputed on read, for the same reason
  /// feeRatePercent is copied: the ledger behind a closed quarter can still be
  /// corrected afterwards, and an issued invoice must always explain the
  /// amount that was actually billed. Nullable for pre-proration rows.
  segments Json?

  /// Billable days for the OPENING book, prorated from the later of
  /// (quarter start, inception). Capital deployed later carries its own
  /// day-count inside `segments` — this field does not describe it.
  daysBilled   Int
  daysInQuarter Int
  feeAmount    Float

  /// Where portfolioValue came from: "snapshot" when the quarter-end
  /// PortfolioValuation row existed, "reconstruction" when the scheduler had
  /// missed that date and the value was replayed from the baseline. Recorded
  /// because the two are equally correct but not equally auditable.
  valuationSource String @default("snapshot")

  createdAt DateTime @default(now())

  /// One fee row per client per quarter — this is what makes closeQuarter
  /// idempotent and re-runnable rather than double-billing on a retry.
  @@unique([clientId, quarter])
  @@index([quarter])
  @@map("client_fee_schedules")
}

/// Firm-wide configuration owned by the Super Admin: what a Portfolio Manager
/// seat costs, how long its free trial runs, and the Razorpay credentials the
/// charges are put through.
///
/// SINGLETON. Exactly one row exists, pinned to `id = "app"` rather than a
/// generated cuid. That is deliberate: a settings table with a floating id
/// invites a second row that silently shadows the first, and "which settings
/// are live" then depends on insertion order. AppSettingsService.load() upserts
/// on the fixed id, so a fresh database self-heals into the documented defaults
/// instead of 500-ing on a missing row.
///
/// Distinct from ClientFeeSchedule, which is the OTHER direction of money: that
/// is the advisory fee this firm charges its investors, while this is what a
/// manager pays the firm for a login. The two never interact.
model AppSetting {
  /// Always the literal "app". See the singleton note above.
  id String @id @map("_id")

  /// Free days granted when a Portfolio Manager login is created. Applied at
  /// creation to stamp User.trialEndsAt — it is NOT read again afterwards, so
  /// changing it here never retroactively extends or shortens a manager whose
  /// trial is already running. Zero means "no trial, pay immediately".
  trialDays Int @default(14)

  /// Seat price per manager, in MAJOR currency units (rupees, not paise).
  ///
  /// Stored as major units because that is what the Super Admin types and what
  /// the table renders; the ×100 conversion to paise happens once, at the
  /// Razorpay call site, where the API contract demands it. Keeping paise in
  /// the database instead would mean every read path had to remember to divide.
  monthlyAmount Float @default(0)
  yearlyAmount  Float @default(0)

  /// ISO-4217 code the two amounts are denominated in. Razorpay settles Indian
  /// accounts in INR, which is why that is the default, but the column exists
  /// so the figures are never ambiguous on screen.
  currency String @default("INR")

  /// Razorpay API credentials.
  ///
  /// `razorpayKeyId` is the PUBLISHABLE half (rzp_test_… / rzp_live_…). It is
  /// safe to return to the browser — the checkout widget needs it client-side.
  ///
  /// `razorpayKeySecret` is the PRIVATE half and is stored AES-256-GCM
  /// encrypted (see crypto.util.ts), never in the clear. It is never included
  /// in any API response: the settings endpoint returns `razorpaySecretLast4`
  /// and a boolean instead, so the UI can prove a key is configured and show
  /// its tail without the value itself ever reaching a client. A database dump
  /// therefore does not hand over the ability to charge cards.
  razorpayKeyId     String?
  razorpayKeySecret String?
  /// Last 4 characters of the plaintext secret, kept alongside the ciphertext
  /// purely so the UI can render "••••4f2a" without a decrypt on every read.
  razorpaySecretLast4 String?

  /// Guards against a live key being used while the product is still in
  /// testing. Surfaced as a badge next to the key on the settings screen.
  razorpayMode String @default("test")

  // ── Corporate Action Engine settings (PART 44) ────────────────────────────
  // On the existing singleton rather than a new collection: these are firm-wide
  // operational policy, exactly like the fields above, and a second
  // one-row table would be duplicate functionality of the kind PART 57 warns
  // against.
  //
  /// Master switch for unattended processing (PART 34). FALSE by default and
  /// deliberately so: the first implementation detects and queues, and a human
  /// clears the data-quality gate. Turning this on lets the scheduler process
  /// actions that clear BOTH the confidence threshold and validation.
  caAutoProcessEnabled Boolean @default(false)

  /// PART 33's threshold. 90 admits official filings, exchange sources and
  /// primary APIs, and excludes secondary (75) and unverified (40) feeds.
  caMinimumConfidenceScore Int @default(90)

  /// 'RETAIN' keeps fractional shares on the holding (the broker supports
  /// them); 'CASH_IN_LIEU' rounds DOWN to whole shares and settles the
  /// remainder in cash; 'ROUND_DOWN' drops the fraction with no compensation.
  /// Whichever applies, the fraction is always recorded on the ledger row —
  /// PART 11's "never round silently" is not a policy option.
  caFractionalSharePolicy String @default("RETAIN")

  /// How cash-in-lieu is priced when the policy calls for it: 'MARKET_PRICE'
  /// values the fraction at the holding's current price, 'COST_BASIS' at its
  /// average cost. Ignored when the fractional policy is RETAIN.
  caCashInLieuPolicy String @default("MARKET_PRICE")

  /// Provider identifiers in descending priority (PART 5/32). The first entry
  /// that reports an event wins the `source` field; later ones are merged in
  /// as secondary references.
  caSourcePriority String[] @default(["company_ir", "sec", "exchange", "fmp", "finnhub"])

  /// Whether a detected action raises a UI notification (PART 53).
  caNotificationEnabled Boolean @default(true)

  /// UTC hour (0-23) the daily scheduler sweep runs at (PART 34/44).
  caProcessingHourUtc Int @default(2)

  /// Who last touched these values, for the "Last updated" line. A plain id
  /// with no relation: the audit line must survive that user being deleted,
  /// and a FK with a cascade would erase the very record we want to keep.
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("app_settings")
}

/// Where a Portfolio Manager's seat stands. Read on every login to decide
/// whether the app opens or the paywall does.
///
/// TRIALING  — inside the free window stamped at creation. Full access.
/// ACTIVE    — a Razorpay payment succeeded; access runs until currentPeriodEnd.
/// EXPIRED   — the trial ran out with no payment.
/// PAST_DUE  — was ACTIVE, the period ended, no renewal landed.
/// CANCELLED — deliberately switched off by the Super Admin.
///
/// EXPIRED and PAST_DUE are kept apart on purpose even though both deny access:
/// one is a manager who never paid and the other is a paying customer whose
/// renewal failed, and those warrant different dunning treatment.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  PAST_DUE
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

/// One payment attempt against a manager's seat, written by the Razorpay
/// webhook and never edited afterwards — this is the audit trail that answers
/// "did this manager actually pay, and when".
///
/// Rows are kept for failed attempts too, not just successful ones: a failed
/// charge is exactly what you need to see when a manager claims they paid.
model SubscriptionPayment {
  id     String @id @default(cuid()) @map("_id")
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Major currency units, matching AppSetting.monthlyAmount — see the note
  /// there on why this is not paise.
  amount   Float
  currency String @default("INR")
  cycle    BillingCycle

  /// Razorpay's own identifiers, kept so a row here can be reconciled against
  /// the Razorpay dashboard. `paymentId` is absent until a charge is captured.
  razorpayOrderId   String?
  razorpayPaymentId String?
  /// "created" | "captured" | "failed" — Razorpay's vocabulary, not ours,
  /// because translating it would only obscure what the dashboard shows.
  status String @default("created")

  /// The access window this payment bought. Copied onto User on capture.
  periodStart DateTime?
  periodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The webhook is retried by Razorpay on any non-2xx, so capture handling has
  /// to be idempotent — this unique index is what makes a replayed webhook a
  /// no-op instead of a second extension of the manager's period.
  @@unique([razorpayOrderId])
  @@index([userId])
  @@index([status])
  @@map("subscription_payments")
}

// ═════════════════════════════════════════════════════════════════════════════
// CORPORATE ACTION ENGINE
//
// Three collections, one direction of dependency:
//
//   CorporateAction  (the EVENT — one row per real-world corporate event)
//        │
//        ├─> CorporateActionLedger  (the EFFECT — one row per client affected)
//        │
//        └─> CorporateActionAuditLog (the RECORD — who did what, append-only)
//
// ── The load-bearing design decision ────────────────────────────────────────
//
// This engine does NOT own a holdings-history table, and that omission is the
// most important thing about it. PortfolioReconstructionService already
// rebuilds any past date by replaying Transaction rows onto a baseline, and it
// already treats SPLIT/BONUS as delta-quantity, zero-cash, zero-cost-basis
// events. So a processor's job is to write ONE correctly-shaped Transaction
// row per client and update the CURRENT Holding — after which:
//
//   * a report for a date BEFORE the ex-date replays without that row and sees
//     the old quantity (PART 24/41),
//   * a report AFTER it replays with the row and sees the new quantity,
//   * historical PortfolioValuation snapshots are never touched (PART 25/50),
//   * performance shows no artificial return, because quantity rose while cost
//     basis total and cash both stayed put (PART 26/52).
//
// Building a parallel holdings-history table would have duplicated that replay
// and created two answers to "what did this client own on 30-Jun". There is
// one answer, and it is the ledger.
// ═════════════════════════════════════════════════════════════════════════════

/// One real-world corporate event, deduplicated across every provider that
/// reported it (PART 3).
///
/// Identity is `fingerprint`, not the provider's id: two feeds reporting the
/// same APH 2:1 split must converge on ONE row carrying TWO sources, never two
/// rows that each half-process the same event. See corporate-action.dedupe.ts.
model CorporateAction {
  id String @id @default(cuid()) @map("_id")

  /// Soft reference to InstrumentProfile.id — NOT a Prisma relation.
  ///
  /// A hard FK would reject every Indian corporate action, because
  /// InstrumentProfile is populated by the US workbook importer and has no row
  /// for RELIANCE.NS. Null here is normal and is not a data error; `symbol`
  /// below is the identifier that always resolves.
  securityId String?
  /// Canonical Yahoo-style symbol ('AAPL' / 'RELIANCE.NS'), normalised through
  /// normalizeSymbol() so it joins directly against Holding.ticker.
  symbol String
  /// Company name as reported at announcement — kept even after a rename, so
  /// the action reads correctly against the name in force at the time.
  company String?
  /// Which book the symbol trades in, derived by marketForSymbol().
  market Market @default(US)

  actionType CorporateActionType

  // ── Dates (PART 3) ────────────────────────────────────────────────────────
  // Every one is optional except `effectiveDate`, because feeds are genuinely
  // incomplete and refusing to STORE a partially-dated action would mean
  // losing the only warning the desk gets. The validator decides which dates a
  // given action type actually requires before it may be PROCESSED.
  announcementDate DateTime?
  declarationDate  DateTime?
  recordDate       DateTime?
  exDate           DateTime?
  /// The date the action takes effect on holdings. Required: it is the date
  /// the ledger row is stamped with and therefore the hinge the whole
  /// before/after history turns on.
  effectiveDate DateTime
  paymentDate   DateTime?
  /// When this engine actually applied it. Null until PROCESSED.
  processingDate DateTime?

  // ── Ratio (PART 6) ────────────────────────────────────────────────────────
  /// '1:2' is stored oldRatio=1, newRatio=2 and means each 1 old share becomes
  /// 2 new ones. '3:2' is oldRatio=3, newRatio=2. The multiplier applied to a
  /// quantity is always newRatio/oldRatio, for forward and reverse alike —
  /// there is no separate reverse-split formula, only a ratio below 1.
  oldRatio Float?
  newRatio Float?

  // ── Cash (PART 13/15/18/22) ───────────────────────────────────────────────
  /// Per-share cash for dividends/distributions, or the per-old-share cash
  /// component of a merger. NOT a total — totals are per-client and live on
  /// the ledger.
  cashAmount Float?
  currency   String?

  // ── Target security, for actions that create or replace one ───────────────
  newSecurityId String?
  newSymbol     String?
  newCompany    String?

  // ── Type-specific payload ─────────────────────────────────────────────────
  /// Fields only some action types carry: rights (subscriptionRatio,
  /// subscriptionPrice, subscriptionStart, subscriptionEnd), spin-off
  /// (distributionRatio), exchange change (oldExchange, newExchange),
  /// delisting (reason, cashSettlement, replacementSymbol), merger
  /// (exchangeRatio, cashPerShare).
  ///
  /// Json rather than 20 mostly-null columns: a new action type is then a new
  /// processor plus an enum value, with no migration — which is what PART 1's
  /// "must allow additional types later" actually requires.
  details Json?

  // ── Provenance (PART 5) ───────────────────────────────────────────────────
  /// The WINNING source's identifier — the highest-priority feed that reported
  /// this event. Denormalised from `sources` so the review grid sorts without
  /// unpacking Json.
  source          String
  sourceUrl       String?
  sourceReference String?
  /// Every source that reported this event, primary first (PART 7's merge
  /// result). Shape: [{ source, tier, url, reference, fetchedAt, payload }].
  /// Never overwritten on a re-fetch — appended to, so provenance accumulates.
  sources Json?

  status CorporateActionStatus @default(DETECTED)

  /// 0-100 (PART 33). Derived from the winning source's tier and degraded by
  /// missing fields or cross-source disagreement.
  confidenceScore Int @default(0)

  /// Set when two sources report materially different figures for the same
  /// event (PART 32). Blocks automatic processing outright, whatever the
  /// confidence score says.
  hasConflict Boolean @default(false)
  /// Human-readable description of the disagreement, shown in the Review
  /// Center. Shape: [{ field, values: [{ source, value }] }].
  conflicts Json?

  /// Deterministic dedupe key over (symbol, type, the dates that identify the
  /// event, ratio) — see fingerprintOf(). Unique: the database, not
  /// application logic, is what makes a double-import impossible.
  fingerprint String @unique

  /// Validation findings from the last validate() run. Shape:
  /// [{ code, severity, message }]. Kept even after a pass so the Review
  /// Center can show warnings that did not block.
  validationErrors Json?
  validatedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy  String?
  approvedBy String?
  approvedAt DateTime?
  /// Why it was rejected, for the audit trail and the grid's tooltip.
  rejectionReason String?

  notes String?

  ledger CorporateActionLedger[]

  @@index([symbol])
  @@index([status])
  @@index([actionType])
  @@index([effectiveDate])
  @@index([market])
  @@index([status, effectiveDate])
  @@map("corporate_actions")
}

/// Every corporate action this engine knows how to represent (PART 1).
///
/// Adding a type here plus a processor registered against it is the entire
/// extension path — no migration, because `details` absorbs type-specific
/// fields and MongoDB has no enum constraint to alter.
enum CorporateActionType {
  STOCK_SPLIT
  REVERSE_SPLIT
  BONUS_ISSUE
  SPECIAL_DIVIDEND
  DIVIDEND
  STOCK_DIVIDEND
  RIGHTS_ISSUE
  SPIN_OFF
  MERGER
  ACQUISITION
  TICKER_CHANGE
  NAME_CHANGE
  EXCHANGE_CHANGE
  DELISTING
  CASH_DISTRIBUTION
  RETURN_OF_CAPITAL
}

/// PART 4. The only transitions the service permits are:
///
///   DETECTED -> PENDING_VALIDATION -> VALIDATED -> PENDING_APPROVAL
///                                  \> REJECTED    -> APPROVED -> PROCESSING
///                                                             -> PROCESSED
///                                                             \> FAILED
///
/// FAILED is re-runnable (PART 36 says "after fixing the error, re-run the
/// entire corporate action"); PROCESSED is terminal and idempotent.
enum CorporateActionStatus {
  DETECTED
  PENDING_VALIDATION
  VALIDATED
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  PROCESSED
  REJECTED
  CANCELLED
  FAILED
}

/// One client's realised exposure to one corporate action — the audit trail of
/// what actually changed (PART 23). Never deleted, including on a re-run:
/// a failed attempt's row is UPDATED in place rather than replaced, so the
/// error that occurred stays visible next to the eventual success.
///
/// `@@unique([corporateActionId, clientId])` is the idempotency key (PART 37).
/// Enforcing it in the database rather than with an application-level "have I
/// run this already?" check is deliberate: two concurrent process() calls
/// racing each other cannot both pass a read-then-write guard, but they cannot
/// both satisfy a unique index.
model CorporateActionLedger {
  id                String          @id @default(cuid()) @map("_id")
  corporateActionId String
  corporateAction   CorporateAction @relation(fields: [corporateActionId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// The book this client's mandate sits in. Denormalised so the ledger can be
  /// reported on without joining Client.
  portfolioId String?

  securityId String?
  symbol     String

  quantityBefore Float
  quantityAfter  Float

  averageCostBefore Float
  averageCostAfter  Float

  marketValueBefore Float
  marketValueAfter  Float

  /// Positive = cash INTO the portfolio (dividend, cash-in-lieu), negative =
  /// cash out (a rights subscription the client took up).
  cashImpact Float  @default(0)
  currency   String @default("USD")

  /// Fractional entitlement that could not be issued as whole shares, before
  /// any cash-in-lieu settlement (PART 11). Zero when the policy retains
  /// fractions or none arose. Recorded even when settled, so "never round
  /// silently" is provable from the data.
  fractionalShares Float @default(0)

  /// The Transaction rows this ledger entry created, so a re-run or an
  /// investigation can find them without guessing by date+ticker.
  transactionIds String[] @default([])

  processedAt DateTime @default(now())

  status       CorporateActionLedgerStatus @default(PENDING)
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([corporateActionId, clientId])
  @@index([corporateActionId])
  @@index([clientId])
  @@index([symbol])
  @@map("corporate_action_ledger")
}

enum CorporateActionLedgerStatus {
  /// Computed in a preview but not yet applied.
  PENDING
  APPLIED
  FAILED
  /// Applied, then reversed. Retained rather than deleted (PART 23).
  REVERSED
}

/// Append-only record of every state change and every processing run (PART 43).
///
/// Separate from CorporateActionLedger because the two answer different
/// questions: the ledger says what a CLIENT'S POSITION became, this says what a
/// PERSON did. A rejection, a validation failure, or an approval that was never
/// processed all belong here and have no ledger row at all.
model CorporateActionAuditLog {
  id String @id @default(cuid()) @map("_id")

  /// Plain id, not a relation: the audit line must survive its action being
  /// deleted, and a cascade would erase precisely the record worth keeping.
  corporateActionId String

  /// 'DETECTED' | 'VALIDATED' | 'APPROVED' | 'REJECTED' | 'PROCESSED' |
  /// 'FAILED' | 'RECONCILED' | 'MERGED_SOURCE' | 'SETTINGS_CHANGED' | ...
  action String

  /// Who. Null for scheduler-driven entries, which are stamped actorLabel
  /// 'system' instead — a null user with a label is honest about automation in
  /// a way that attributing it to a service account would not be.
  userId     String?
  actorLabel String @default("system")

  /// State either side of the change, as JSON. For a processing run this is
  /// the aggregate (total shares before/after); per-client detail lives in the
  /// ledger.
  beforeValue Json?
  afterValue  Json?

  source String?
  /// Present only where the request carried one — the existing Session model
  /// captures IP for logins, and this mirrors that where available (PART 43).
  ipAddress String?
  userAgent String?

  reason String?

  createdAt DateTime @default(now())

  @@index([corporateActionId])
  @@index([action])
  @@index([createdAt])
  @@map("corporate_action_audit_log")
}
