# Database
DATABASE_URL=mongodb://localhost:27017/atlas_pms

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRATION=3600

# Server
NODE_ENV=development
PORT=3001

# CORS
CORS_ORIGIN=http://localhost:3000

# File Storage
AWS_S3_BUCKET=atlas-pms-storage
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password

# Automated Client Review Pack — AI commentary (spec §93)
# COMMENTARY_PROVIDER: gemini | fallback | disabled. Defaults to "fallback",
# which uses the deterministic template and needs no API key.
COMMENTARY_PROVIDER=fallback
COMMENTARY_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Macro data providers — not yet wired to a live source in this phase.
NSE_API_ENABLED=false
RBI_API_ENABLED=false
MOSPI_API_ENABLED=false
FRED_API_KEY=
BLS_API_ENABLED=false
BEA_API_ENABLED=false
