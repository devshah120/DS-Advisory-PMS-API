# Dependencies
node_modules/

# Build output
dist/
build/
# The incremental-build cache. If this is ever committed, tsc trusts it over
# the (ignored, therefore absent) dist/ on a fresh checkout and skips emitting
# entirely — nest build exits 0 and produces no main.js.
*.tsbuildinfo

# Environment variables
.env
.env.*.local
.env.local

# Logs
logs/
*.log
npm-debug.log*

# Prisma
prisma/*.db
prisma/migrations/dev/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Coverage
coverage/
